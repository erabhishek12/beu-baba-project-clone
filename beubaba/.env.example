# ============================================================================
# BEU BABA — environment configuration
#
# The app runs on a LOCAL MOCK backend by default (no config needed) so the
# preview always works. To use the real Supabase backend, set these and rebuild.
# ============================================================================

# Backend selector: "mock" (default) or "supabase"
VITE_BACKEND=mock

# Supabase project credentials (only used when VITE_BACKEND=supabase).
# Find these in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
