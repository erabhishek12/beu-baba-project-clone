# BEU BABA backend selector.
#
# Leave VITE_BACKEND unset (or 'mock') to run entirely on the local demo data.
# The app then needs no server and every screen still works.
#
# Set 'supabase' to use the real question bank: quizzes are drawn from the
# database (~5 KB per quiz instead of a 5.2 MB file), answer keys stay on the
# server, and the admin MCQ review desk becomes available.
VITE_BACKEND=mock

# Required only when VITE_BACKEND=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL, printed on downloaded result cards and share links.
# Example: VITE_SITE_URL=beubaba.app
VITE_SITE_URL=
